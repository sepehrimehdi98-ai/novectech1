# Set this locally, never in a VITE_ variable and never in frontend code.
OPENROUTER_API_KEY=
# Multilingual retrieval model. Override after evaluating Persian/English queries.
RAG_EMBEDDING_MODEL=baai/bge-m3
# Optional RAG tuning. Evaluate these against real questions before production.
RAG_MIN_VECTOR_SIM=0.55
RAG_MAX_CHUNKS=4
RAG_RRF_K=60
# Production app origin. Set to the public HTTPS origin.
# NODE_ENV=production
# APP_ORIGIN=https://novextech.ir
# HOST=0.0.0.0
# PORT=8787
# Liara persistent disk is mounted at /data by liara.json.
# DATABASE_PATH=/data/novextech.sqlite
# INITIAL_ADMIN_EMAIL=admin@example.com
# INITIAL_ADMIN_PASSWORD=
# Trust X-Forwarded-For only when the app sits behind a known reverse proxy.
# TRUST_PROXY=1

# Kavimo master/line token stays on this server.
KAVIMO_TOKEN=
# Hostname only: for example stream.your-domain.com, already connected in Kavimo.
KAVIMO_STREAM_DOMAIN=stream.novextech.ir
# Optional: restrict the integration to a dedicated Kavimo line.
KAVIMO_LINE_ID=

